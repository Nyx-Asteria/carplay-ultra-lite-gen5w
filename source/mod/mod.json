{
  "id": "carplay-ultra-lite-k5",
  "name": "CarPlay Ultra-Lite K5",
  "version": "0.1.0-alpha.1",
  "hmgapi": ">=1.1.0-rc.8",
  "authors": [
    "cp-climate contributors"
  ],
  "license": "GPL-3.0-or-later",
  "description": "Development port for the Kia K5 DL322 USA 260507. Not validated on-car. Uses existing wireless projection; Ultra theme and video remain disabled pending integration and validation. Based on LIVI (GPL-3.0).",
  "system": [
    {
      "model": [
        "DL322"
      ],
      "region": "USA",
      "firmware": "260507"
    }
  ],
  "hooks": {
    "jar": "hooks.jar",
    "entry": "ioniq6.cpclimate.CpClimate",
    "points": {
      "dipo.carplay.session_started": "observe",
      "dipo.carplay.session_finalized": "observe"
    },
    "native": {
      "libCarPlayCore.so": [
        "recipes/carplay-climate-m1.recipe"
      ]
    }
  },
  "network": {
    "rules": [
      {
        "chain": "input",
        "in": "hotspot",
        "proto": "tcp",
        "ports": [
          "7130-7135"
        ],
        "action": "accept"
      }
    ]
  },
  "requires": [
    "wireless-carplay-aa"
  ],
  "conflicts": [
    "egmp-carplay-ev-routing",
    "cp-climate"
  ]
}
